<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 200" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0b3c5d"/>
      <stop offset="60%" stop-color="#07273d"/>
      <stop offset="100%" stop-color="#00b493"/>
    </linearGradient>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fbbf24"/>
      <stop offset="100%" stop-color="#d97706"/>
    </linearGradient>
  </defs>
  <rect width="800" height="200" rx="12" fill="url(#bgGrad)"/>
  <circle cx="750" cy="20" r="100" fill="#00b493" opacity="0.15"/>
  <circle cx="50" cy="190" r="80" fill="#00b493" opacity="0.2"/>
  <g transform="translate(60, 40)">
    <path d="M 60 5 Q 110 5 110 50 Q 110 95 60 115 Q 10 95 10 50 Q 10 5 60 5 Z" fill="#0b3c5d" stroke="url(#goldGrad)" stroke-width="4"/>
    <path d="M 40 45 L 80 45 L 75 75 L 45 75 Z" fill="none" stroke="#26d0ab" stroke-width="3"/>
    <circle cx="60" cy="25" r="6" fill="#fbbf24"/>
    <line x1="30" y1="85" x2="90" y2="85" stroke="#ffffff" stroke-width="2"/>
  </g>
  <g transform="translate(200, 75)">
    <text x="0" y="0" font-family="'Segoe UI', Arial, sans-serif" font-size="38" font-weight="800" fill="#ffffff">CITY UNIVERSITY</text>
    <text x="2" y="32" font-family="'Segoe UI', Arial, sans-serif" font-size="16" font-weight="600" fill="#26d0ab">EXCELLENCE IN EDUCATION &amp; INNOVATION</text>
    <text x="2" y="62" font-family="'Segoe UI', Arial, sans-serif" font-size="13" font-weight="500" fill="#94a3b8">Academic Portal &bull; Batch 62</text>
  </g>
</svg>
